# Supabase (Auth + DB + Realtime + private Storage)
# Get these from https://supabase.com → Project Settings → API / Database
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Prisma / Postgres (Database settings → Connection string)
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?schema=public

# App URL (must match your deployed domain for OAuth redirects)
NEXT_PUBLIC_SITE_URL=https://YOUR-APP.vercel.app
NEXT_PUBLIC_APP_URL=https://YOUR-APP.vercel.app

# Optional: GIF Wall search (falls back to demo GIFs if unset)
NEXT_PUBLIC_GIPHY_KEY=
