# Optional OpenAI (live extraction / brain answers)
OPENAI_API_KEY=

# Required for real login + Google Auth + cloud multi-tenant data
# Leave blank to use the local JWT demo (recommended for npm run dev)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional server admin operations
SUPABASE_SERVICE_ROLE_KEY=

# App URL (OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Local demo JWT fallback (used only when Supabase keys are missing)
AUTH_SECRET=tactix-dev-secret-change-me
