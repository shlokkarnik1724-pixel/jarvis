// Circle Web Portal — Prisma schema
// Synced with Supabase PostgreSQL + auth.users

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  owner
  admin
  member
}

enum GameType {
  mafia
  trivia
  prediction_league
  myth_buster
}

enum GameStatus {
  lobby
  active
  completed
  cancelled
}

enum ScoreType {
  game_win
  event_attendance
  custom
  roast_toast
}

model User {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships        CircleMember[]
  checkins           EventCheckin[]
  claimedItems       ShoppingListItem[] @relation("ClaimedItems")
  uploadedPhotos     Photo[]
  leaderboardEntries LeaderboardEntry[]
  tabPayments        TabTracker[]       @relation("TabPayer")
  nicknameEdits      NicknameHistory[]  @relation("NicknameEditor")
  roastVotes         RoastToastVote[]

  @@map("users")
}

model Circle {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  inviteCode String   @unique @default(dbgenerated("encode(gen_random_bytes(6), 'hex')")) @map("invite_code")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  members         CircleMember[]
  events          Event[]
  photos          Photo[]
  leaderboard     LeaderboardEntry[]
  tabs            TabTracker[]
  gameSessions    GameSession[]
  roastToasts     RoastToast[]
  nicknameHistory NicknameHistory[]

  @@map("circles")
}

model CircleMember {
  circleId String     @map("circle_id") @db.Uuid
  userId   String     @map("user_id") @db.Uuid
  nickname String?
  role     MemberRole @default(member)
  joinedAt DateTime   @default(now()) @map("joined_at") @db.Timestamptz(6)

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([circleId, userId])
  @@index([circleId, userId])
  @@map("circle_members")
}

model Event {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  circleId  String   @map("circle_id") @db.Uuid
  title     String
  date      DateTime @db.Timestamptz(6)
  location  String?
  latitude  Float?
  longitude Float?
  tags      String[] @default([])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  circle   Circle             @relation(fields: [circleId], references: [id], onDelete: Cascade)
  checkins EventCheckin[]
  shopping ShoppingListItem[]

  @@index([circleId, date])
  @@map("events")
}

model EventCheckin {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  checkedInAt DateTime @default(now()) @map("checked_in_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, userId])
  @@map("event_checkins")
}

model ShoppingListItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  itemName  String   @map("item_name")
  claimerId String?  @map("claimer_id") @db.Uuid
  quantity  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  claimer User? @relation("ClaimedItems", fields: [claimerId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@map("shopping_list_items")
}

model Photo {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  circleId     String   @map("circle_id") @db.Uuid
  uploaderId   String   @map("uploader_id") @db.Uuid
  storagePath  String   @map("storage_path")
  encryptedUrl String?  @map("encrypted_url")
  iv           String?
  mimeType     String   @default("image/jpeg") @map("mime_type")
  captionEnc   String?  @map("caption_enc")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  circle   Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  uploader User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([circleId, uploaderId])
  @@map("photos")
}

model LeaderboardEntry {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  circleId  String    @map("circle_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  scoreType ScoreType @map("score_type")
  points    Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([circleId, scoreType])
  @@map("leaderboard")
}

model TabTracker {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  circleId    String   @map("circle_id") @db.Uuid
  payerId     String   @map("payer_id") @db.Uuid
  amount      Decimal  @db.Decimal(12, 2)
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  payer  User   @relation("TabPayer", fields: [payerId], references: [id], onDelete: Cascade)

  @@index([circleId])
  @@map("tab_tracker")
}

model GameSession {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  circleId  String     @map("circle_id") @db.Uuid
  gameType  GameType   @map("game_type")
  state     Json       @default("{}")
  status    GameStatus @default(lobby)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([circleId, status])
  @@map("game_sessions")
}

model RoastToast {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  circleId      String   @map("circle_id") @db.Uuid
  kind          String
  encryptedBody String   @map("encrypted_body")
  iv            String
  voteScore     Int      @default(0) @map("vote_score")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  circle Circle           @relation(fields: [circleId], references: [id], onDelete: Cascade)
  votes  RoastToastVote[]

  @@index([circleId])
  @@map("roast_toasts")
}

model RoastToastVote {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roastToastId String   @map("roast_toast_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  value        Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roastToast RoastToast @relation(fields: [roastToastId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roastToastId, userId])
  @@map("roast_toast_votes")
}

model NicknameHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  circleId  String   @map("circle_id") @db.Uuid
  targetId  String   @map("target_id") @db.Uuid
  editorId  String   @map("editor_id") @db.Uuid
  nickname  String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  editor User   @relation("NicknameEditor", fields: [editorId], references: [id], onDelete: Cascade)

  @@index([circleId, targetId])
  @@map("nickname_history")
}
